{
    "version": "2.0.0",
    "manual": "https://code.visualstudio.com/docs/editor/tasks",
    "tasks": [
        {
            "label": "make_version",
            "type": "shell",
            "command": "${workspaceFolder}/script/make_version.bat",
            "args": [
                "${workspaceFolder}/src/app"
            ],
            "group": "build"
        },
        {
            "label": "cmake_win32",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset win32"
            ],
            "group": "build",
        },
        {
            "label": "build_win32d",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset win32-debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build_win32",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset win32-release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "cmake_android",
            "type": "shell",
            "command": [
                "cmake"
            ],
            "args": [
                "--preset android"
            ],
            "group": "build",
        },
        {
            "label": "build_mingw",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}/build/mingw"
            },
            "command": "mingw32-make",
            "group": "build",
            "dependsOn": [],
        },
        {
            "label": "mkdir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/build,${workspaceFolder}/build/android,${workspaceFolder}/build/win32,${workspaceFolder}/build/mingw"
            ],
            "group": "build"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "${workspaceFolder}/script/clean.bat",
            "group": "build"
        },
        {
            "label": "deployqt_win32",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "$exeFiles = Get-ChildItem -Path '${workspaceFolder}/build/win32/Release' -Filter '*.exe'; if ($exeFiles.Count -gt 0) { $exeFiles | ForEach-Object { Write-Host \"Deploying: $($_.Name)\"; & 'C:/Qt/6.8.0/msvc2022_64/bin/windeployqt.exe' --qmldir '${workspaceFolder}/res/qml' $_.FullName --release } } else { Write-Host 'No exe files found in Release directory' }"
            ],
            "group": "build"
        },
        {
            "label": "deployqt_win32d",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "$exeFiles = Get-ChildItem -Path '${workspaceFolder}/build/win32/Debug' -Filter '*.exe'; if ($exeFiles.Count -gt 0) { $exeFiles | ForEach-Object { Write-Host \"Deploying: $($_.Name)\"; & 'C:/Qt/6.8.0/msvc2022_64/bin/windeployqt.exe' --qmldir '${workspaceFolder}/res/qml' $_.FullName --debug } } else { Write-Host 'No exe files found in Debug directory' }"
            ],
            "group": "build"
        }
    ]
}
